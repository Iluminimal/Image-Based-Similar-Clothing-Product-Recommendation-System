# .env болгож хуулна (`make infra` үүнийг автоматаар хийнэ). Жинхэнэ утгыг хэзээ ч commit хийхгүй.
# Эдгээр нь дотоод хөгжүүлэлтийн анхдагч утга, нууц биш.

# --- docker compose (infra/docker-compose.dev.yml) ---
POSTGRES_USER=angel
POSTGRES_PASSWORD=angel
POSTGRES_DB=angel
# Хост порт. Суулгасан Postgres-тэй зөрчилдөхгүйн тулд 5432 биш 5433.
POSTGRES_PORT=5433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (apps/api) ---
APP_ENV=dev
LOG_LEVEL=INFO
# true = JSON мөр (анхдагч, production-д ашиглагддаг); false = хүнд уншигдахуйц console гаралт.
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://angel:angel@localhost:5433/angel
REDIS_URL=redis://localhost:6379/0
# CORS-оор зөвшөөрөх browser origin-ууд (таслалаар тусгаарлана).
CORS_ORIGINS=http://localhost:3000

# --- зураг ба ML (apps/api) ---
# Барааны жижиг зургийг хадгалах folder (API эдгээрийг /media хаягаар өгнө). Замыг apps/api-аас тооцно.
MEDIA_DIR=../../data/media
MEDIA_URL_PATH=/media
MEDIA_BASE_URL=http://localhost:8000/media
# Kaggle "Fashion Product Images" фолдер: styles.csv болон images/ байна (`make ingest` ашиглана).
DATASET_DIR=/Users/you/Datasets/fashion
# fashion-clip = жинхэнэ загвар. fake = CI-ийн end-to-end тестэд зориулсан тогтмол хиймэл загвар
# (татах хэрэггүй, үр дүн утгагүй); APP_ENV=prod үед ашиглахыг хориглоно.
EMBEDDER=fashion-clip
# auto = эхлээд CUDA, дараа нь Apple MPS, эцэст нь CPU
EMBEDDING_DEVICE=auto
EMBEDDING_FP16=false
# Үүнийг сольвол embedding-ийн утга өөрчлөгдөнө: дараа нь `make ingest ARGS=--reembed` ажиллуулна.
EMBEDDING_RESIZE_MODE=pad
# Зураг дээрх хувцасны хэсэг олох арга:
#   yolo  = YOLOv8m (Fashionpedia) хувцас, гутал, цүнхийг тусад нь олно (анх ачаалахад ~200 MB татна)
#   whole = хэсэг олохгүй, бүтэн зургаар хайна
#   fake  = CI-ийн end-to-end тестэд (зургийг дээд, доод хоёр хуваана); prod-д хориотой
LOCALIZER=yolo
LOCALIZER_DEVICE=auto
YOLO_CONFIDENCE=0.25
YOLO_MAX_REGIONS=5
# Зургийн талбайн хэдэн хувиас бага хайрцгийг хаях вэ; хайрцгийг хэдэн хувиар томруулж тайрах вэ.
YOLO_MIN_AREA=0.01
YOLO_PADDING=0.05

# --- хайлт (apps/api) ---
# Оруулах зургийг хэмжээ болон пикселийн тоогоор хязгаарлана (decompression bomb-оос хамгаалах).
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_PIXELS=25000000
SEARCH_DEFAULT_LIMIT=24
# Холимог хайлт ("үүнтэй адил, гэхдээ ...") дахь текстийн жин.
HYBRID_TEXT_WEIGHT=0.65
DETECTED_CATEGORIES=3
# Redis cache (текстийн embedding, төстэй бараа).
TEXT_EMBEDDING_CACHE_TTL_SECONDS=86400
SIMILAR_CACHE_TTL_SECONDS=300
CATALOG_FILTERS_CACHE_TTL_SECONDS=600
REDIS_OP_TIMEOUT_SECONDS=0.5
# Клиентийн хаяг тутмын хүсэлтийн хязгаар: "<хүсэлтийн тоо>/<цонхны секунд>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMAGE=20/60
# Камерын live preview-ийн кадрын хязгаар (/search/detect). Хайлтаас тусад нь тоолно.
RATE_LIMIT_DETECT=300/60
RATE_LIMIT_TEXT=60/60
RATE_LIMIT_SIMILAR=120/60
# Зөвхөн өөрийн удирддаг reverse proxy-ийн ард true болгоно (клиентийн хаяг X-Forwarded-For-оос авагдана).
TRUST_PROXY_HEADERS=false

# --- хэрэглэгчийн бүртгэл (apps/api) ---
# Access token-ы гарын үсгийн түлхүүр. 32+ санамсаргүй тэмдэгт: `openssl rand -base64 48`. APP_ENV=prod үед заавал
# өгнө. Хөгжүүлэлтэд хоосон бол API асах бүрд шинэ түлхүүр үүсэх тул дахин асаахад бүх хэрэглэгч гарна.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Админ, агуулахын ажилтан ийм олон цаг идэвхгүй байвал нэвтрэлт нь дуусна (ердийн хэрэглэгчийнх дээрх хоногоор).
STAFF_REFRESH_TTL_HOURS=12
# APP_ENV=prod үед заавал true болно. http://localhost-д false үлдээнэ.
COOKIE_SECURE=false
# Client-ийн хаяг тус бүрийн хязгаар: "<хүсэлтийн тоо>/<цонхны секунд>". Амжилтгүй нэвтрэлтийг имэйл тус бүрээр ч
# хязгаарлана.
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_LOGIN_EMAIL=5/300
# Имэйл тус бүрийн өдрийн хязгаар: нууц үгийг удаанаар таах оролдлогыг зогсооно. Хязгаарт хүрвэл эзэнд мэдэгдэнэ.
RATE_LIMIT_LOGIN_EMAIL_DAILY=20/86400
# Browser-ийн CSP зөрчлийн мэдээлэл (POST /api/v1/security/csp-report).
RATE_LIMIT_CSP_REPORT=30/60
RATE_LIMIT_REFRESH=60/60
RATE_LIMIT_ADMIN=120/60
# Сэтгэгдэл бичих, засах, устгах хүсэлтийн хязгаар (client-ийн хаяг тус бүрээр).
RATE_LIMIT_REVIEW=20/3600
# Цуцлах, буцаах хүсэлт (клиентийн хаяг тутамд).
RATE_LIMIT_ORDER_REQUEST=10/3600

# --- нэг удаагийн код: утас/и-мэйлээр нэвтрэх, баталгаажуулах, солих, нууц үг сэргээх (apps/api) ---
# console = мессежийг API-ийн логт бичнэ (кодыг тэндээс уншина). twilio = жинхэнээр илгээнэ
# (APP_ENV=prod үед заавал). Twilio token-г хэзээ ч commit хийхгүй.
SMS_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Имэйл (нэг удаагийн код, захиалгын мэдэгдэл). console = API-ийн логт бичнэ. smtp = SMTP серверээр
# илгээнэ: dev-д `make infra`-ийн Mailpit (илгээсэн имэйлийг http://localhost:8025 дээр харна),
# APP_ENV=prod үед жинхэнэ SMTP заавал. SMTP нууц үгийг хэзээ ч commit хийхгүй.
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# true бол STARTTLS-ээр шифрлэнэ (жинхэнэ SMTP-д; Mailpit-д шаардлагагүй).
SMTP_STARTTLS=false
MAIL_FROM=Angel <no-reply@angel.local>
# Улсын кодгүй бичсэн дугаарыг энэ улсынх гэж үзнэ (ISO 3166 alpha-2, жишээ нь MN, US, GB).
DEFAULT_PHONE_REGION=MN
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Клиентийн хаяг тутам, "<хүсэлтийн тоо>/<цонхны секунд>".
RATE_LIMIT_OTP_SEND=10/600
RATE_LIMIT_OTP_VERIFY=30/600
# Хоосон үлдээнэ. Зургаан оронтой тоо өгвөл БҮХ код тэр утга болно: зөвхөн end-to-end тест, demo-д
# (APP_ENV=prod үед ашиглахыг хориглоно).
OTP_DEV_CODE=
# true бол ажилтан (админ, агуулах) хоёр шатлалт нэвтрэлт (баталгаажуулагч апп) тохируулах хүртэл back-office ашиглаж
# чадахгүй. APP_ENV=prod үед үргэлж true. 2FA ашиглахад JWT_SECRET заавал тохируулсан байх ёстой. JWT_SECRET-ийг солих
# бол ажилтан бүрд `make reset-2fa EMAIL=...` ажиллуулна.
STAFF_2FA_REQUIRED=false

# --- сагс ба төлбөр тооцоо (apps/api) ---
CART_MAX_QUANTITY=10
CART_MAX_LINES=50
CART_GUEST_TTL_DAYS=30
# Бүх үнэ бага нэгжээр: төгрөг x 100 (5,000 ₮ = 500000).
CURRENCY=MNT
SHIPPING_STANDARD_UB_CENTS=500000
SHIPPING_EXPRESS_UB_CENTS=1200000
SHIPPING_STANDARD_RURAL_CENTS=1000000
# Энэ дүнгээс дээш бол энгийн хүргэлт үнэгүй (150,000 ₮).
FREE_SHIPPING_THRESHOLD_CENTS=15000000
# Дэлгүүрээс авах цэгийн хаяг (checkout-д харагдана).
PICKUP_ADDRESS=Улаанбаатар, Сүхбаатар дүүрэг, 1-р хороо, Бага тойруу 1
# Захиалга төлбөр хүлээж байхад барааг нөөцөлнө; төлөөгүй захиалгын бараа энэ хугацааны дараа чөлөөлөгдөнө.
ORDER_PENDING_TTL_MINUTES=30
# Амжилтгүй болсон буцаалтыг (refund_pending) дахин оролдох завсарлага, минутаар.
REFUND_RETRY_MINUTES=15

# --- төлбөр (apps/api) ---
# qpay    = QPay-ийн QR төлбөр (https://developer.qpay.mn). Дэлгүүр төгрөгөөр үнэлдэг тул захиалгын дүн яг
#           нэхэмжлэгдэнэ (хөрвүүлэлтгүй). Холбохоосоо өмнө `make qpay-check`-ээр credential-ээ шалга.
# offline = provider-гүй туршилт: checkout дээр "туршилтын төлбөр" гарна. APP_ENV=prod үед хориглоно.
PAYMENTS_MODE=offline
# Sandbox-ийн нийтийн тест утгууд: TEST_MERCHANT / 123456 / TEST_INVOICE. Production-д QPay-ээс авсан өөрийн утга,
# QPAY_BASE_URL=https://merchant.qpay.mn. Secret-ийг хэзээ ч commit хийхгүй.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# Төлбөрийн дараа QPay энэ хаягаар API руу мэдэгдэнэ (/api/v1/webhooks/qpay): интернетээс хандах ёстой. Локалд
# `cloudflared tunnel --url http://localhost:8000` эсвэл ngrok-ийн хаягийг тавина; мэдэгдэл хүрэхгүй бол
# худалдан авагч "Төлбөрөө шалгах" товчоор баталгаажуулна.
QPAY_CALLBACK_BASE_URL=http://localhost:8000

# --- Google-ээр нэвтрэх (apps/api) ---
# Client id, secret-ийг хоосон үлдээвэл "Continue with Google" товч харагдахгүй.
# Google Cloud Console дээр үүсгэнэ: OAuth consent screen (External, Testing, өөрийгөө test user болгож нэмнэ),
# дараа нь Credentials > Create OAuth client ID > Web application, доорх redirect URI-тай.
# Дэлгэрэнгүй: docs/commerce.md ("Sign in with Google"). Secret-ийг хэзээ ч commit хийхгүй.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google console-д яг энэ хаягийг бүртгэнэ. Энэ нь вэбийн хаяг, харин Next /api/v1-ийг API руу дамжуулна. Тиймээс
# callback-ийн тавьсан session cookie сайтын өөрийн cookie болно.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Callback дууссаны дараа browser-ийг явуулах хаяг (алдаатай бол /login?error=... руу).
WEB_BASE_URL=http://localhost:3000
# google = жинхэнэ урсгал. fake = тест, CI-д зориулсан процесс доторх хиймэл хувилбар (APP_ENV=prod үед хориглоно).
OAUTH_MODE=google

# --- web (apps/web) ---
# Browser API руу хандах хаяг.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Сайтын нийтийн хаяг (canonical URL, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Заавал биш, зөвхөн server талд: Next.js server API руу нийтийн хаягаас өөр хаягаар хандах бол энд бичнэ (жишээ нь
# docker compose дотор http://api:8000). Хоосон бол NEXT_PUBLIC_API_URL-ийг ашиглана.
# API_INTERNAL_URL=

# Энэ тоо ба түүнээс бага үлдэгдэлтэй барааг админ самбарт "үлдэгдэл бага" гэж тооцно.
LOW_STOCK_THRESHOLD=5
# Dashboard, CSV тайлан, агуулахын "өнөөдөр"-ийн өдрийн хил (IANA нэр). Өгөгдөл UTC-ээр хадгалагдана.
SHOP_TIMEZONE=Asia/Ulaanbaatar
# Web-ийн огноо сонгогч мөн энэ бүсийг ашиглана (build үед тогтоно; анхдагч нь дээрхтэй ижил).
# NEXT_PUBLIC_SHOP_TIMEZONE=Asia/Ulaanbaatar
# Төлөгдсөнөөс хойш энэ цагаас удаан илгээгдээгүй захиалга агуулахын самбарт "хугацаа хэтэрсэн" гэж харагдана.
SHIP_SLA_HOURS=24
# Хүргэгдсэнээс хойш хэдэн хоногт буцаах хүсэлт гаргаж болох вэ. Энэ бол дэлгүүрийн бодлого тул хуулийн шаардлагатай
# тулгана.
RETURN_WINDOW_DAYS=14

# Мэдэгдлийн имэйлийн дараалал (outbox) ба хуучин өгөгдөл цэвэрлэх хугацаанууд (дэлгүүрийн бодлого).
OUTBOX_POLL_SECONDS=5
HOUSEKEEPING_INTERVAL_SECONDS=3600
OTP_RETENTION_HOURS=24
REFRESH_TOKEN_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=180
EMAIL_SENT_RETENTION_DAYS=7
EMAIL_FAILED_RETENTION_DAYS=30
